# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Supabase ──────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=another_long_random_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Client ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Cloudinary (optional — for image/PDF uploads) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional — for contact form emails) ────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Academic Profile <noreply@example.com>"
ADMIN_EMAIL=admin@example.com
