# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/academic_profile
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/academic_profile

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ── Client ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Academic Profile <noreply@example.com>"
ADMIN_EMAIL=admin@example.com
